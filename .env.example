# ==============================================================================
# PAGie — Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real keys below.
#   3. NEVER commit the .env file to Git. It is already listed in .gitignore.
# ==============================================================================


# ------------------------------------------------------------------------------
# Runtime mode
# dev  = local LLM for development/testing (no API rate-limit interruptions)
# prod = Gemini for final/demo to match proposal
# ------------------------------------------------------------------------------
APP_MODE=dev

# ------------------------------------------------------------------------------
# Google AI Studio — Gemini LLM (used in APP_MODE=prod)
# Get your key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# ------------------------------------------------------------------------------
# Gemini Model Name (optional — defaults to gemini-2.0-flash if not set)
# Update this to use a newer model as it becomes available in Google AI Studio.
# Common options: gemini-2.0-flash, gemini-2.0-pro, gemini-3.0-flash
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-1.5-flash-latest

# ------------------------------------------------------------------------------
# Local LLM (used in APP_MODE=dev)
# Requires Ollama running locally
# ------------------------------------------------------------------------------
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen3.5:0.8b
OLLAMA_BASE_URL=http://localhost:11434

# If Gemini hits 429 in prod mode, allow temporary local fallback
ALLOW_429_FALLBACK_TO_LOCAL=true

# ------------------------------------------------------------------------------
# Google Drive — Knowledge Base Folder
# 1. Create a folder in Google Drive named "PAGie_Knowledge_Base"
# 2. Add all your PDFs, notes, and docs into it
# 3. Copy the folder ID from the URL:
#    https://drive.google.com/drive/folders/YOUR_FOLDER_ID_IS_HERE
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ------------------------------------------------------------------------------
# Google Cloud Storage — Persistent ChromaDB Storage (for Streamlit Cloud)
# 1. Create a GCS bucket in Google Cloud Console
# 2. Create a service account with "Storage Object Admin" role
# 3. Download the JSON key file
# 4. Set GCS_CREDENTIALS_JSON to the path of the JSON file (for local)
#    or paste the JSON content (for Streamlit Cloud secrets)
# ------------------------------------------------------------------------------
GCS_ENABLED=false
GCS_BUCKET_NAME=pagie-chromadb-storage
GCS_CREDENTIALS_JSON=path/to/service-account-key.json

# Optional ingestion filters to reduce noisy corpus during rebuild
# Comma-separated substrings matched against source path
INCLUDE_ONLY_SOURCE_PATTERNS=
EXCLUDE_SOURCE_PATTERNS=benchmark,invoice,recovery-codes,SETUP_COMPLETE,test_malicious
MIN_CHARS_PER_DOC=40
RESET_CHROMA_ON_REBUILD=true

# ------------------------------------------------------------------------------
# Notion Integration — API Token
# 1. Go to: https://www.notion.so/my-integrations
# 2. Click "+ New integration" → give it a name (e.g. "PAGie")
# 3. Copy the "Internal Integration Token" below
# 4. Share your Notion database with the integration (open database → ... → Add connections)
# ------------------------------------------------------------------------------
NOTION_TOKEN=secret_your_notion_integration_token_here

# ------------------------------------------------------------------------------
# Notion Database ID
# Open your Notion database in the browser. The URL looks like:
#   https://www.notion.so/YOUR_WORKSPACE/DATABASE_ID?v=...
# Copy the DATABASE_ID part (the 32-character hex string before the "?").
# ------------------------------------------------------------------------------
NOTION_DATABASE_ID=your_notion_database_id_here
