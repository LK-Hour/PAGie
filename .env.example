# ==============================================================================
# PAGie — Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real keys below.
#   3. NEVER commit the .env file to Git. It is already listed in .gitignore.
# ==============================================================================


# ------------------------------------------------------------------------------
# Google AI Studio — Gemini LLM + Text Embedding Model
# Get your key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# ------------------------------------------------------------------------------
# Gemini Model Name (optional — defaults to gemini-2.0-flash if not set)
# Update this to use a newer model as it becomes available in Google AI Studio.
# Common options: gemini-2.0-flash, gemini-2.0-pro, gemini-3.0-flash
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Google Drive — Knowledge Base Folder
# 1. Create a folder in Google Drive named "PAGie_Knowledge_Base"
# 2. Add all your PDFs, notes, and docs into it
# 3. Copy the folder ID from the URL:
#    https://drive.google.com/drive/folders/YOUR_FOLDER_ID_IS_HERE
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ------------------------------------------------------------------------------
# Notion Integration — API Token
# 1. Go to: https://www.notion.so/my-integrations
# 2. Click "+ New integration" → give it a name (e.g. "PAGie")
# 3. Copy the "Internal Integration Token" below
# 4. Share your Notion database with the integration (open database → ... → Add connections)
# ------------------------------------------------------------------------------
NOTION_TOKEN=secret_your_notion_integration_token_here

# ------------------------------------------------------------------------------
# Notion Database ID
# Open your Notion database in the browser. The URL looks like:
#   https://www.notion.so/YOUR_WORKSPACE/DATABASE_ID?v=...
# Copy the DATABASE_ID part (the 32-character hex string before the "?").
# ------------------------------------------------------------------------------
NOTION_DATABASE_ID=your_notion_database_id_here
